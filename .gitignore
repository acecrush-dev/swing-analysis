# ── multi-role delivery workflow artefacts ─────────────────────────────
# planner/worker 协作中间产物;仓库使用者不需要
.cc-delivery/

# ── in-repo planning scratch ────────────────────────────────────────────
# plans/ 是项目内的规划草稿(plans/README.md 索引 + 单个 plan 的 md)
# 给 planner/worker 协作使用,不是发布给仓库使用者的产物
plans/

# ── node / electron build intermediates ─────────────────────────────────
node_modules/
dist/
out/
.electron-vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── docs build output (VitePress → GitHub Pages) ───────────────────────
# NOTE: .gitignore has no inline comments — `pattern # text` is matched
# literally as a filename containing spaces and never ignores anything.
# generated static site (npm run docs:build)
docs/.vitepress/dist/
# vitepress dev/build cache
docs/.vitepress/cache/
# .nojekyll gets re-emitted by the deploy workflow if needed locally.

# electron-builder / electron-forge
release/
*.blockmap
electron-builder-cache/

# ── python venv + runtime + build intermediates ────────────────────────
backend/.venv/
# service.json, jobs/<id>/segments.json etc.
backend/data/
# All model files (backend/models/*.onnx and *.task) live in Git LFS,
# so a fresh clone just gets 134-byte pointer text — fetch via
# `git lfs pull` or `bash scripts/fetch-model.sh` to materialise them.
# No exception rule needed: LFS-tracked files are stored as pointers in git
# but the real binary is downloaded on `git lfs checkout`.
# if CLI --out-dir points here
backend/cli_jobs/
# PyInstaller one-file build output (see scripts/build-python-bundle.js)
backend/dist/
# PyInstaller --workpath / --specpath intermediates (scripts/build-python-bundle.js)
backend/build/
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
# The build/ tree mixes checked-in artefacts (icon.ico, icon.icns, icon.png,
# entitlements.mac.plist) with regenerated intermediates (mac-icon.iconset,
# win-icon.ico) and electron-builder output. Keep only the final assets.
# NOTE: must be `build/*`, NOT `build/` — a directory-level exclude makes git
# skip the whole dir, so the `!` re-includes below can never match ("cannot
# re-include a file if a parent directory of that file is excluded"). The
# `build/` form silently untracked the icons → CI packaged with the default
# Electron icon and a broken extraResources icon.png.
build/*
!build/icon.png
!build/icon.ico
!build/icon.icns
!build/entitlements.mac.plist
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── TS / editor ─────────────────────────────────────────────────────────
*.tsbuildinfo
.vscode/
.idea/
.DS_Store
*.swp
*.mp4
.testcase*
test-results/
data
*.zip
*.test
.env
