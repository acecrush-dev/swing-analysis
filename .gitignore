# ── multi-role delivery workflow artefacts ─────────────────────────────
# planner/worker 协作中间产物;仓库使用者不需要
.cc-delivery/

# ── in-repo planning scratch ────────────────────────────────────────────
# plans/ 是项目内的规划草稿(plans/README.md 索引 + 单个 plan 的 md)
# 给 planner/worker 协作使用,不是发布给仓库使用者的产物
plans/

# ── node / electron build intermediates ─────────────────────────────────
node_modules/
dist/
out/
.electron-vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── docs build output (mkdocs → GitHub Pages) ───────────────────────────
site/
docs/.cache/
# .nojekyll is built by mkdocs build but the marker file we ship in the repo
# is just a hint for local dev; the deployed site gets a fresh one.

# electron-builder / electron-forge
release/
*.blockmap
electron-builder-cache/

# ── python venv + runtime + build intermediates ────────────────────────
backend/.venv/
backend/data/                    # service.json, jobs/<id>/segments.json etc.
# Only pose_landmarker_lite.task is committed (5.5 MB; fetched model lives
# next to the code so a fresh clone runs out of the box; scripts/fetch-model.sh
# re-downloads only if missing). The 'heavy' variant (29 MB) and any other
# .task experiments are intentionally NOT tracked.
backend/models/*.task
!backend/models/pose_landmarker_lite.task
backend/cli_jobs/                # if CLI --out-dir points here
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── TS / editor ─────────────────────────────────────────────────────────
*.tsbuildinfo
.vscode/
.idea/
.DS_Store
*.swp
*.mp4
.testcase*
test-results/
