node_modules/
dist/
out/
.electron-vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# electron-builder / electron-forge
release/
*.blockmap
electron-builder-cache/

# ── python venv + runtime + build intermediates ────────────────────────
backend/.venv/
backend/data/                    # service.json, jobs/<id>/segments.json etc.
backend/models/*.task            # pose_landmarker_lite.task (binary, fetched)
backend/models/*.tflite
backend/cli_jobs/                # if CLI --out-dir points here
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

