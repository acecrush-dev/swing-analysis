# Use npmmirror CDN for Electron binary downloads.
# node's built-in fetch cannot reliably reach github.com in some network
# environments (Connect Timeout on github.com:443), so the default
# `https://github.com/electron/electron/releases/download/...` URL fails
# during `pnpm install` and `node_modules/electron/dist/` is never
# populated, which causes electron-vite to throw "Error: Electron uninstall".
#
# @electron/get honours this value via npm_config_electron_mirror / the
# `electron_mirror` key in .npmrc, so the binary download succeeds and
# `pnpm dev` can launch Electron.
electron_mirror=https://cdn.npmmirror.com/binaries/electron/

# pnpm by default does NOT run install/postinstall scripts of transitive
# dependencies (security default). Electron's install.js (which downloads
# the binary) is one such script, so without this flag the dist/ folder
# is never populated even when the mirror is reachable.
#
# This re-enables dependency install scripts. Keep this in the project
# .npmrc (not the user-level one) so the behaviour is reproducible for
# every contributor / CI runner.
enable-pre-post-scripts=true