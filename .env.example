# ── Swing-Analysis backend selection ──────────────────────────────────────
# `python` (default): Electron main spawns the PyInstaller sidecar (full
#   feature set — segmentation + bbox + skeleton overlay + viz.mp4).
# `ts`: do NOT spawn Python. All processing eventually runs in renderer
#   via onnxruntime-web + @mediapipe/tasks-vision (Phase 2+). Phase 1
#   shows a placeholder UI only.
SWING_BACKEND=ts
